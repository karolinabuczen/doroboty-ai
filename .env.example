# Copy to .env.local for local development (or run `npm run auth:seed`, which creates it for you).
# Never commit real values. On Vercel set the same variables in Project Settings → Environment Variables.

# Random string, at least 32 characters. Signs the login cookie.
SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# JSON list of accounts. "hash" is a salted scrypt hash, never a plain password.
# Generate with `npm run auth:seed`.
AUTH_USERS='[{"id":"candidate-anna","login":"anna.kowalska","role":"candidate","hash":"scrypt:..."}]'

# Public PostHog project key (EU region; public by design). Leave empty to disable analytics.
VITE_POSTHOG_KEY=phc_pYKCeVDw3fhCWb7BRc5DUexSkXHHWKDc6Qnwhq9qCQFJ
